# ============================================================
# HelloMamaBetter — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- App ---
APP_NAME=HelloMamaBetter
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Database credentials (used by docker-compose and the URL vars below) ---
POSTGRES_USER=hmb_user
POSTGRES_PASSWORD=hmb_pass
POSTGRES_DB=hellomamabetter
POSTGRES_TEST_DB=hellomamabetter_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_TEST_PORT=5435

# --- Database URLs (async driver for app, sync driver for alembic) ---
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_SYNC_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
TEST_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_TEST_PORT}/${POSTGRES_TEST_DB}
TEST_DATABASE_SYNC_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_TEST_PORT}/${POSTGRES_TEST_DB}

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Field-level encryption ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME_TO_A_FERNET_KEY

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- AWS ---
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=hellomamabetter-uploads
SES_FROM_EMAIL=no-reply@hellomamabetter.app
SNS_SMS_SENDER_ID=HMB

# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_SECRET=

# --- Logging ---
LOG_LEVEL=INFO
